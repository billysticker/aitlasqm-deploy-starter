+}
+.own-connections-hero h1 {
+  margin: 2px 0 4px;
+  font-size: 26px;
+  font-weight: 650;
+  letter-spacing: -0.025em;
+}
+.own-connections-hero p {
+  max-width: 680px;
+  margin: 0;
+  color: var(--muted-foreground);
+}
+.own-connections-toolbar {
+  display: grid;
