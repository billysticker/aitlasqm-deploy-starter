+  align-items: flex-start;
+  gap: 16px;
+  padding: 5px 0 26px 18px;
+  border-left: 4px solid var(--brand-accent);
+}
+.own-connections-hero-mark {
+  display: grid;
+  place-items: center;
+  width: 40px;
+  height: 40px;
+  flex: 0 0 40px;
+  border-radius: 12px;
