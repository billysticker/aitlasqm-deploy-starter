+  border-radius: 12px;
+  background: color-mix(in srgb, var(--background) 96%, var(--secondary));
+  box-shadow: 0 1px 2px color-mix(in srgb, var(--foreground) 5%, transparent);
+  transition: border-color 0.12s ease, box-shadow 0.12s ease, transform 0.12s ease;
+}
+.own-connection-card:hover {
+  border-color: color-mix(in srgb, var(--brand-accent) 35%, var(--border));
+  box-shadow: 0 8px 22px color-mix(in srgb, var(--foreground) 8%, transparent);
+  transform: translateY(-1px);
+}
+.own-connection-card.connected {
