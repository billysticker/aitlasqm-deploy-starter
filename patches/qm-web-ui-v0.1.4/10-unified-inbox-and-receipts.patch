+  position: fixed;
+  inset: 0;
+  z-index: 80;
+  display: grid;
+  place-items: center;
+  padding: 20px;
+  background: color-mix(in srgb, #000 48%, transparent);
+}
+.inbox-confirm {
+  width: min(520px, 100%);
+  max-height: min(680px, calc(100dvh - 40px));
+  overflow-y: auto;
+  box-sizing: border-box;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  padding: 20px;
+  background: var(--background);
+  color: var(--foreground);
+  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.3);
+}
+.inbox-confirm > p {
+  margin: 10px 0;
+  color: var(--muted-foreground);
+}
+.inbox-confirm-copy {
+  max-height: 260px;
+  overflow-y: auto;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  padding: 12px;
+  background: color-mix(in srgb, var(--secondary) 35%, var(--background));
+}
+.inbox-confirm-warning {
+  color: var(--destructive, #b42318) !important;
+  font-size: 11.5px;
+}
+.inbox-confirm .actions {
+  justify-content: flex-end;
+  margin-top: 16px;
+}
+
+@media (max-width: 860px) {
+  .unified-inbox-pane {
+    overflow-y: auto;
+    padding: 16px;
+  }
+  .inbox-head,
+  .inbox-toolbar {
+    align-items: stretch;
+    flex-direction: column;
+  }
+  .inbox-head-actions {
+    justify-content: flex-end;
+  }
+  .inbox-search {
+    width: auto;
+  }
+  .inbox-workbench {
+    flex: 0 0 auto;
+    min-height: 720px;
+    grid-template-columns: 1fr;
+    grid-template-rows: minmax(220px, 34vh) minmax(480px, 1fr);
+    overflow: visible;
+  }
+  .inbox-list {
+    border-right: 0;
+    border-bottom: 1px solid var(--border);
+  }
+}
+
+@media (max-width: 520px) {
+  .inbox-head h1 { font-size: 22px; }
+  .inbox-head-actions .btn { flex: 1; }
+  .inbox-source-filters > button { flex: 1; justify-content: center; }
+  .inbox-message { width: 92%; }
+  .inbox-compose-fields { grid-template-columns: 1fr; }
+  .inbox-subject { grid-column: auto; }
+  .inbox-composer-foot { align-items: stretch; flex-direction: column; }
+  .inbox-composer-foot .btn { align-self: flex-end; }
+}
