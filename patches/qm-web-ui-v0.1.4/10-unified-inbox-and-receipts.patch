+
+/* Unified inbox — a live, private view over the signed-in teammate's accounts. */
+.unified-inbox-pane {
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  padding: 22px;
+}
+.inbox-head,
+.inbox-toolbar,
+.inbox-row,
+.inbox-row-top,
+.inbox-thread-head,
+.inbox-composer-foot,
+.inbox-head-actions,
+.inbox-source-filters {
+  display: flex;
+  align-items: center;
+}
+.inbox-head {
+  justify-content: space-between;
+  gap: 20px;
+}
+.inbox-head h1,
+.inbox-thread-head h2,
+.inbox-confirm h2,
+.inbox-thread-welcome h2 {
+  margin: 0;
+  color: var(--foreground);
+}
+.inbox-head h1 {
+  font-size: 25px;
+  letter-spacing: -0.025em;
+}
+.inbox-head p,
+.inbox-thread-head p,
+.inbox-thread-welcome p {
+  margin: 3px 0 0;
+  color: var(--muted-foreground);
+}
+.inbox-kicker {
+  display: block;
+  color: var(--muted-foreground);
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  margin-bottom: 3px;
+}
+.inbox-head-actions,
+.inbox-source-filters {
+  gap: 7px;
+}
+.inbox-toolbar {
+  justify-content: space-between;
+  gap: 12px;
+  padding-bottom: 12px;
+  border-bottom: 1px solid var(--border);
+}
+.inbox-source-filters {
+  flex-wrap: wrap;
+}
+.inbox-source-filters > button {
+  appearance: none;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  border: 1px solid var(--border);
+  border-radius: 999px;
+  background: var(--background);
+  color: var(--muted-foreground);
+  padding: 5px 10px 5px 6px;
+  font: inherit;
+  font-size: 12px;
+  cursor: pointer;
+}
+.inbox-source-filters > button.active {
+  border-color: color-mix(in srgb, var(--foreground) 28%, var(--border));
+  color: var(--foreground);
+  background: color-mix(in srgb, var(--secondary) 70%, var(--background));
+}
+.inbox-source-mark {
+  width: 22px;
+  height: 22px;
+  flex: 0 0 22px;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 6px;
+  color: white;
+  font-size: 10px;
+  font-weight: 800;
+}
+.inbox-source-mark.gmail,
+.inbox-row-accent.gmail { background: #d64b3f; }
+.inbox-source-mark.outlook,
+.inbox-row-accent.outlook { background: #2474c6; }
+.inbox-source-mark.slack,
+.inbox-row-accent.slack { background: #6d3f78; }
+.inbox-search {
+  width: min(320px, 42vw);
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  padding: 7px 10px;
+  color: var(--muted-foreground);
+  background: var(--background);
+}
+.inbox-search:focus-within {
+  border-color: var(--primary, var(--brand-accent));
+  box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary, var(--brand-accent)) 15%, transparent);
+}
+.inbox-search input {
+  width: 100%;
+  min-width: 0;
+  border: 0;
+  outline: 0;
+  background: transparent;
+  color: var(--foreground);
+  font: inherit;
+}
+.inbox-notice {
+  margin: -4px 0 0 !important;
+}
+.inbox-workbench {
+  flex: 1;
+  min-height: 0;
+  display: grid;
+  grid-template-columns: minmax(280px, 34%) minmax(0, 1fr);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  overflow: hidden;
+  background: var(--background);
+  box-shadow: 0 10px 30px color-mix(in srgb, #000 5%, transparent);
+}
+.inbox-list {
+  min-width: 0;
+  overflow-y: auto;
+  border-right: 1px solid var(--border);
+  background: color-mix(in srgb, var(--secondary) 24%, var(--background));
+}
+.inbox-row {
+  position: relative;
+  width: 100%;
+  min-width: 0;
+  gap: 10px;
+  border: 0;
+  border-bottom: 1px solid var(--border);
+  background: transparent;
+  color: var(--foreground);
+  padding: 13px 14px 13px 16px;
+  text-align: left;
+  font: inherit;
+  cursor: pointer;
+}
+.inbox-row:hover,
+.inbox-row.active {
+  background: color-mix(in srgb, var(--secondary) 70%, var(--background));
+}
+.inbox-row.active {
+  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand-accent) 22%, transparent);
+}
+.inbox-row-accent {
+  position: absolute;
+  inset: 9px auto 9px 0;
+  width: 3px;
+  border-radius: 0 3px 3px 0;
+}
+.inbox-row-copy {
+  display: block;
+  min-width: 0;
+  flex: 1;
+}
+.inbox-row-top {
+  justify-content: space-between;
+  gap: 8px;
+}
+.inbox-row-top strong,
+.inbox-row-title,
+.inbox-row-preview {
+  display: block;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.inbox-row-top strong {
+  font-size: 12.5px;
+  font-weight: 550;
+}
+.inbox-row.unread .inbox-row-top strong,
+.inbox-row.unread .inbox-row-title {
+  font-weight: 750;
+}
+.inbox-row time,
+.inbox-message-meta time {
+  flex: 0 0 auto;
+  color: var(--muted-foreground);
+  font-size: 10.5px;
+}
+.inbox-row-title {
+  margin-top: 2px;
+  font-size: 12.5px;
+}
+.inbox-row-preview {
+  margin-top: 2px;
+  color: var(--muted-foreground);
+  font-size: 11.5px;
+}
+.inbox-list-state,
+.inbox-thread-empty,
+.inbox-thread-welcome {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  color: var(--muted-foreground);
+  text-align: center;
+  padding: 34px 22px;
+}
+.inbox-list-state span {
+  font-size: 12px;
+}
+.inbox-thread {
+  min-width: 0;
+  min-height: 0;
+  display: grid;
+  grid-template-rows: auto minmax(0, 1fr) auto;
+  background: var(--background);
+}
+.inbox-thread-welcome {
+  display: flex;
+  height: 100%;
+  box-sizing: border-box;
+}
+.inbox-thread-welcome svg {
+  color: color-mix(in srgb, var(--brand-accent) 75%, var(--muted-foreground));
+}
+.inbox-thread-head {
+  min-height: 70px;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 13px 18px;
+  border-bottom: 1px solid var(--border);
+}
+.inbox-thread-head h2,
