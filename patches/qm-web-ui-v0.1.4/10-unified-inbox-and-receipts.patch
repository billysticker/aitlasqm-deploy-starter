+  font-size: 17px;
+  letter-spacing: -0.012em;
+}
+.inbox-thread-head p {
+  font-size: 11.5px;
+}
+.inbox-messages {
+  min-height: 0;
+  overflow-y: auto;
+  padding: 18px;
+  background: color-mix(in srgb, var(--secondary) 12%, var(--background));
+}
+.inbox-message {
+  width: min(78%, 680px);
+  box-sizing: border-box;
+  margin: 0 0 12px;
+  padding: 11px 13px;
+  border: 1px solid var(--border);
+  border-radius: 6px 14px 14px;
+  background: var(--background);
+}
+.inbox-message.outgoing {
+  margin-left: auto;
+  border-radius: 14px 6px 14px 14px;
+  background: color-mix(in srgb, var(--brand-accent) 8%, var(--background));
+}
+.inbox-message-meta {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+  margin-bottom: 5px;
+  font-size: 11px;
+}
+.inbox-message p {
+  margin: 0;
+  color: var(--foreground);
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+  font-size: 13px;
+}
+.inbox-composer {
+  padding: 12px;
+  border-top: 1px solid var(--border);
+  background: var(--background);
+}
+.inbox-composer textarea,
+.inbox-compose-fields input,
+.inbox-compose-fields select {
+  box-sizing: border-box;
+  width: 100%;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  background: var(--background);
+  color: var(--foreground);
+  font: inherit;
+}
+.inbox-composer textarea {
+  min-height: 74px;
+  max-height: 180px;
+  resize: vertical;
+  padding: 10px;
+}
+.inbox-composer textarea:focus,
+.inbox-compose-fields input:focus,
+.inbox-compose-fields select:focus {
+  outline: 2px solid color-mix(in srgb, var(--primary, var(--brand-accent)) 28%, transparent);
+  outline-offset: 1px;
+}
+.inbox-compose-fields {
+  display: grid;
+  grid-template-columns: 130px minmax(0, 1fr);
+  gap: 9px;
+  margin-bottom: 9px;
+}
+.inbox-compose-fields label {
+  color: var(--muted-foreground);
+  font-size: 10.5px;
+  font-weight: 650;
+}
+.inbox-compose-fields input,
+.inbox-compose-fields select {
+  display: block;
+  margin-top: 3px;
+  padding: 7px 8px;
+}
+.inbox-subject {
+  grid-column: 1 / -1;
+}
+.inbox-composer-foot {
+  justify-content: space-between;
+  gap: 12px;
+  margin-top: 8px;
+  color: var(--muted-foreground);
+  font-size: 10.5px;
+}
+.inbox-composer-foot > span {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+}
