diff --git a/plugins/web-ui/src/brain-map-model.ts b/plugins/web-ui/src/brain-map-model.ts
new file mode 100644
index 00000000..72e3b481
--- /dev/null
+++ b/plugins/web-ui/src/brain-map-model.ts
@@ -0,0 +1,102 @@
+export interface BrainNode { id: string; type: string; authority: string; label: string; connector?: string | null; detail?: string | null; operational?: boolean }
+export interface BrainEdge { id: string; from: string; to: string; type: string; recordId?: string | null; recordIds?: string[]; confidence: number; provenance: string; operational?: boolean }
+export interface BrainLink { recordId: string; entityId: string; type: string; confidence: number; provenance: string }
+export interface BrainRecord { id: string; sourceId: string; connector: string; title: string; sourcePointer?: string | null; occurredAt?: string | null; updatedAt?: string | null }
+export interface BrainGraph { nodes: BrainNode[]; edges: BrainEdge[]; links: BrainLink[]; records: BrainRecord[]; sourceCount: number; topologyStatus?: string }
+export interface Filters { person: string; connector: string; query: string; entityType: string; selectedId: string }
+
+export function recordsFor(graph: BrainGraph, id: string) {
+  const ids = new Set(graph.links.filter(link => link.entityId === id).map(link => link.recordId));
+  for (const edge of graph.edges) if (edge.from === id || edge.to === id) {
+    if (edge.recordId) ids.add(edge.recordId);
+    for (const recordId of edge.recordIds || []) ids.add(recordId);
+  }
+  return graph.records.filter(record => ids.has(record.id));
+}
+
+// Only explicit record-to-entity mappings create evidence connections. Sharing a
+// department or appearing in a meeting title is not a client/tool relationship.
+export function withEvidenceEdges(graph: BrainGraph): BrainGraph {
+  const edges = [...graph.edges];
+  const nodes = new Map(graph.nodes.map(node => [node.id, node]));
+  for (const record of graph.records) {
+    const links = graph.links.filter(link => link.recordId === record.id);
+    const tools = links.filter(link => link.type === 'uses-tool' && nodes.get(link.entityId)?.type === 'tool-account');
+    const subjects = links.filter(link => ['person', 'client', 'project', 'location', 'campaign'].includes(nodes.get(link.entityId)?.type || ''));
+    for (const tool of tools) for (const subject of subjects) edges.push({
+      id: 'mapped-' + record.id + '-' + subject.entityId, from: subject.entityId, to: tool.entityId,
+      type: 'linked-evidence', recordId: record.id, confidence: subject.confidence, provenance: subject.provenance,
+    });
+  }
+  const grouped = new Map<string, BrainEdge>();
+  for (const edge of edges) {
+    const key = JSON.stringify([edge.from, edge.to, edge.type, !!edge.operational]);
+    const previous = grouped.get(key);
+    grouped.set(key, { ...edge, id: previous?.id || edge.id, recordIds: [...new Set([
+      ...(previous?.recordIds || []), ...(edge.recordIds || []), ...(edge.recordId ? [edge.recordId] : []),
+    ])] });
+  }
+  return { ...graph, edges: [...grouped.values()] };
+}
+
+export function neighbors(graph: BrainGraph, id: string) {
+  return graph.edges.flatMap(edge => {
+    const otherId = edge.from === id ? edge.to : edge.to === id ? edge.from : '';
+    const other = graph.nodes.find(node => node.id === otherId);
+    return other ? [{ edge, other }] : [];
+  }).sort((a, b) => a.other.label.localeCompare(b.other.label));
+}
+
+export function neighborhood(graph: BrainGraph, id: string) {
+  const ids = new Set([id]);
+  const adjacent = neighbors(graph, id);
+  for (const { other } of adjacent) ids.add(other.id);
+  if (graph.nodes.find(node => node.id === id)?.type === 'person') {
+    for (const { other } of adjacent.filter(({ other }) => other.type === 'client')) {
+      for (const next of neighbors(graph, other.id)) {
+        if (!['person', 'department', 'client'].includes(next.other.type)) ids.add(next.other.id);
+      }
+    }
+  }
+  return ids;
+}
+
+export function toolMatch(graph: BrainGraph, node: BrainNode, connector: string): boolean {
+  if (!connector) return true;
+  if (node.connector === connector || recordsFor(graph, node.id).some(record => record.connector === connector)) return true;
+  if (['client', 'project', 'location', 'campaign'].includes(node.type)) {
+    return neighbors(graph, node.id).some(({ other }) => other.type === 'tool-account' &&
+      (other.connector === connector || recordsFor(graph, other.id).some(record => record.connector === connector)));
+  }
+  return false;
+}
+
+export function visibleGraph(graph: BrainGraph, filters: Filters) {
+  const personScope = filters.person ? neighborhood(graph, filters.person) : null;
+  const focusScope = filters.selectedId ? neighborhood(graph, filters.selectedId) : null;
+  const scope = graph.nodes.filter(node => (!personScope || personScope.has(node.id)) && (!focusScope || focusScope.has(node.id)));
+  const needle = filters.query.trim().toLowerCase();
+  const matches = scope.filter(node =>
+    (!filters.entityType || node.type === filters.entityType) &&
+    (!needle || (node.label + ' ' + (node.detail || '')).toLowerCase().includes(needle)) &&
+    toolMatch(graph, node, filters.connector));
+  const ids = new Set(matches.map(node => node.id));
+  const filtered = Boolean(needle || filters.entityType || filters.connector);
+  if (filtered) {
+    // Keep context on the paths that actually matched, never expand through a
+    // shared department/tool into unrelated people's clients.
+    for (const node of matches) for (const { other } of neighbors(graph, node.id)) {
+      if (!scope.some(candidate => candidate.id === other.id)) continue;
+      if (other.id === filters.person || other.id === filters.selectedId ||
+          (other.type === 'tool-account' && toolMatch(graph, other, filters.connector))) ids.add(other.id);
+    }
+  }
+  const nodes = scope.filter(node => ids.has(node.id));
+  return { ...graph, nodes, edges: graph.edges.filter(edge => ids.has(edge.from) && ids.has(edge.to)), matches };
+}
+
+export function safeSourceUrl(value?: string | null) {
+  if (!value) return null;
+  try { const url = new URL(value); return ['https:', 'http:'].includes(url.protocol) && !url.username && !url.password ? url.href : null; }
+  catch { return null; }
+}
