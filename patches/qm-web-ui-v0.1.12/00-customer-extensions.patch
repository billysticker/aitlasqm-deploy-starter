diff --git a/plugins/web-ui/src/unified-inbox.ts b/plugins/web-ui/src/unified-inbox.ts
new file mode 100644
index 00000000..f44aaa5d
--- /dev/null
+++ b/plugins/web-ui/src/unified-inbox.ts
@@ -0,0 +1,372 @@
+import { html, nothing, render } from "lit";
+import { ExternalLink, Inbox, Plus, RefreshCw, Search, Send, ShieldCheck } from "lucide";
+import { api } from "./core-bridge";
+import { errMessage } from "../../chassis/src/errors";
+import { appState, replacePanePreservingFocus, switchView } from "./shell";
+import { icon } from "./ui";
+
+type Source = "gmail" | "outlook" | "slack";
+
+interface Conversation {
+  id: string;
+  source: Source;
+  threadId: string;
+  channelId?: string;
+  messageId?: string;
+  title: string;
+  participant: string;
+  preview: string;
+  lastAt: string | null;
+  unread: boolean;
+  sourceUrl?: string;
+}
+
+interface Message {
+  id: string;
+  sender: string;
+  recipients: string[];
+  text: string;
+  sentAt: string | null;
+  outgoing: boolean;
+}
+
+const SOURCES: Source[] = ["gmail", "outlook", "slack"];
+const LABEL: Record<Source, string> = { gmail: "Gmail", outlook: "Outlook", slack: "Slack" };
+
+let conversations: Conversation[] = [];
+let connected: Source[] = [];
+let enabled = new Set<Source>(SOURCES);
+let selected: Conversation | null = null;
+let messages: Message[] = [];
+let query = "";
+let notice = "";
+let loading = false;
+let threadLoading = false;
+let composing = false;
+let composeSource: Source = "gmail";
+let recipient = "";
+let subject = "";
+let draft = "";
+let confirmSend = false;
+let sending = false;
+
+export function resetUnifiedInboxState(): void {
+  conversations = [];
+  connected = [];
+  enabled = new Set(SOURCES);
+  selected = null;
+  messages = [];
+  query = "";
+  notice = "";
+  loading = false;
+  threadLoading = false;
+  composing = false;
+  composeSource = "gmail";
+  recipient = "";
+  subject = "";
+  draft = "";
+  confirmSend = false;
+  sending = false;
+}
+
+function date(value: string | null): string {
+  if (!value) return "";
+  const parsed = new Date(value);
+  if (Number.isNaN(parsed.valueOf())) return "";
+  const today = new Date();
+  return parsed.toDateString() === today.toDateString()
+    ? parsed.toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" })
+    : parsed.toLocaleDateString(undefined, { month: "short", day: "numeric" });
+}
+
+function sourceMark(source: Source) {
+  return html`<span class="inbox-source-mark ${source}" aria-label=${LABEL[source]}>${LABEL[source][0]}</span>`;
+}
+
+function extractEmail(value: string): string {
+  return value.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/i)?.[0] ?? "";
+}
+
+function beginReply(row: Conversation): void {
+  composing = false;
+  recipient = row.source === "slack" ? row.channelId ?? "" : extractEmail(row.participant);
+  subject = row.title;
+  draft = "";
+  confirmSend = false;
+}
+
+function beginCompose(): void {
+  selected = null;
+  messages = [];
+  composing = true;
+  composeSource = connected[0] ?? "gmail";
+  recipient = "";
+  subject = "";
+  draft = "";
+  confirmSend = false;
+  draw();
+}
+
+function conversationList() {
+  if (loading) return html`<div class="inbox-list-state">Loading conversations…</div>`;
+  if (!connected.length) {
+    return html`<div class="inbox-list-state">
+      <strong>No messaging accounts connected</strong>
+      <span>Add a private work account to start.</span>
+      <button class="btn" type="button" @click=${() => switchView("connections")}>Add a connection</button>
+    </div>`;
+  }
+  if (!conversations.length) return html`<div class="inbox-list-state">No recent conversations found.</div>`;
+  return conversations.map((row) => html`
+    <button
+      type="button"
+      class="inbox-row ${selected?.id === row.id ? "active" : ""} ${row.unread ? "unread" : ""}"
+      @click=${() => void openConversation(row)}
+    >
+      <span class="inbox-row-accent ${row.source}" aria-hidden="true"></span>
+      ${sourceMark(row.source)}
+      <span class="inbox-row-copy">
+        <span class="inbox-row-top"><strong>${row.participant || LABEL[row.source]}</strong><time>${date(row.lastAt)}</time></span>
+        <span class="inbox-row-title">${row.title}</span>
+        <span class="inbox-row-preview">${row.preview || "Open conversation"}</span>
+      </span>
+    </button>`);
+}
+
+function composer(source: Source, row?: Conversation) {
+  const threaded = Boolean(row);
+  return html`<form class="inbox-composer" @submit=${(event: Event) => {
+    event.preventDefault();
+    if (!draft.trim() || (!threaded && !recipient.trim())) return;
+    confirmSend = true;
+    draw();
+  }}>
+    ${!threaded ? html`
+      <div class="inbox-compose-fields">
+        <label>Account
+          <select .value=${composeSource} @change=${(event: Event) => {
+            composeSource = (event.target as HTMLSelectElement).value as Source;
+            draw();
+          }}>
+            ${connected.map((item) => html`<option value=${item}>${LABEL[item]}</option>`)}
+          </select>
+        </label>
+        <label>${source === "slack" ? "Channel" : "To"}
+          <input required maxlength="500" .value=${recipient} @input=${(event: Event) => recipient = (event.target as HTMLInputElement).value} />
+        </label>
+        ${source !== "slack" ? html`<label class="inbox-subject">Subject
+          <input required maxlength="300" .value=${subject} @input=${(event: Event) => subject = (event.target as HTMLInputElement).value} />
+        </label>` : nothing}
+      </div>` : nothing}
+    <label class="sr-only" for="inbox-message">Message</label>
+    <textarea
+      id="inbox-message"
+      data-focus-key="inbox-message"
+      maxlength="8000"
+      placeholder=${threaded ? "Write a reply…" : "Write a message…"}
+      .value=${draft}
+      @input=${(event: Event) => {
+        draft = (event.target as HTMLTextAreaElement).value;
+        const submit = (event.currentTarget as HTMLTextAreaElement).form?.querySelector<HTMLButtonElement>(
+          'button[type="submit"]',
+        );
+        if (submit) submit.disabled = sending || !draft.trim();
+      }}
+    ></textarea>
+    <div class="inbox-composer-foot">
+      <span>${icon(ShieldCheck, 14)} Only the exact text you write here is sent.</span>
+      <button class="btn primary" type="submit" ?disabled=${sending || !draft.trim()}>${icon(Send, 14)} Review send</button>
+    </div>
+  </form>`;
+}
+
+function threadView() {
+  if (composing) {
+    return html`<section class="inbox-thread">
+      <header class="inbox-thread-head"><div><span class="inbox-kicker">New message</span><h2>${LABEL[composeSource]}</h2></div></header>
+      <div class="inbox-thread-empty">Your message stays private to this account.</div>
+      ${composer(composeSource)}
+    </section>`;
+  }
+  if (!selected) return html`<section class="inbox-thread inbox-thread-welcome">
+    ${icon(Inbox, 34)}
+    <h2>One place for your conversations</h2>
+    <p>Select a thread, or start a new message from a connected account.</p>
+  </section>`;
+  return html`<section class="inbox-thread">
+    <header class="inbox-thread-head">
+      <div>
+        <span class="inbox-kicker">${LABEL[selected.source]}</span>
+        <h2>${selected.title}</h2>
+        <p>${selected.participant}</p>
+      </div>
+      ${selected.sourceUrl ? html`<a class="icon-btn" href=${selected.sourceUrl} target="_blank" rel="noopener" aria-label="Open original conversation" title="Open original conversation">${icon(ExternalLink, 16)}</a>` : nothing}
+    </header>
+    <div class="inbox-messages" aria-live="polite">
+      ${threadLoading
+        ? html`<div class="inbox-thread-empty">Loading messages…</div>`
+        : messages.length
+          ? messages.map((message) => html`<article class="inbox-message ${message.outgoing ? "outgoing" : ""}">
+              <div class="inbox-message-meta"><strong>${message.sender || "Unknown sender"}</strong><time>${date(message.sentAt)}</time></div>
+              <p>${message.text || "No text content"}</p>
+            </article>`)
+          : html`<div class="inbox-thread-empty">No readable messages found in this thread.</div>`}
+    </div>
+    ${composer(selected.source, selected)}
+  </section>`;
+}
+
+function sendDialog() {
+  if (!confirmSend) return nothing;
+  const source = selected?.source ?? composeSource;
+  const destination = selected
+    ? selected.source === "slack" ? selected.title : selected.participant
+    : recipient;
+  return html`<div class="inbox-confirm-scrim" @click=${(event: MouseEvent) => event.target === event.currentTarget && cancelSend()}>
+    <section class="inbox-confirm" role="alertdialog" aria-modal="true" aria-labelledby="inbox-confirm-title">
+      <span class="inbox-kicker">Final check</span>
+      <h2 id="inbox-confirm-title">Send through ${LABEL[source]}?</h2>
+      <p>To: <strong>${destination}</strong></p>
+      ${source !== "slack" ? html`<p>Subject: <strong>${subject || selected?.title}</strong></p>` : nothing}
+      <div class="inbox-confirm-copy">${draft}</div>
+      <p class="inbox-confirm-warning">Do not send patient health information or credentials.</p>
+      <div class="actions">
+        <button class="btn" type="button" ?disabled=${sending} @click=${cancelSend}>Keep editing</button>
+        <button class="btn primary" type="button" ?disabled=${sending} @click=${() => void sendMessage()}>${icon(Send, 14)} ${sending ? "Sending…" : "Send now"}</button>
+      </div>
+    </section>
+  </div>`;
+}
+
+function cancelSend(): void {
+  if (sending) return;
+  confirmSend = false;
+  draw();
+}
+
+function draw(): void {
+  if (appState.currentView !== "inbox" || !appState.mainEl) return;
+  const host = document.createElement("div");
+  host.className = "pane unified-inbox-pane";
+  render(html`
+    <div class="inbox-head">
+      <div><span class="inbox-kicker">Your private communication desk</span><h1>Unified inbox</h1><p>Read and reply across your connected work accounts.</p></div>
+      <div class="inbox-head-actions">
+        <button class="btn" type="button" @click=${beginCompose} ?disabled=${!connected.length}>${icon(Plus, 15)} New message</button>
+        <button class="icon-btn" type="button" aria-label="Refresh inbox" title="Refresh inbox" @click=${() => void loadInbox()}>${icon(RefreshCw, 16)}</button>
+      </div>
+    </div>
+    <div class="inbox-toolbar">
+      <div class="inbox-source-filters" aria-label="Message sources">
+        ${SOURCES.map((source) => html`<button
+          type="button"
+          class=${enabled.has(source) ? "active" : ""}
+          aria-pressed=${enabled.has(source) ? "true" : "false"}
+          @click=${() => {
+            enabled.has(source) ? enabled.delete(source) : enabled.add(source);
+            void loadInbox();
+          }}
+        >${sourceMark(source)} ${LABEL[source]}</button>`)}
+      </div>
+      <form class="inbox-search" @submit=${(event: Event) => { event.preventDefault(); void loadInbox(); }}>
+        ${icon(Search, 16)}<label class="sr-only" for="inbox-search">Search conversations</label>
+        <input id="inbox-search" type="search" placeholder="Search conversations" .value=${query} @input=${(event: Event) => query = (event.target as HTMLInputElement).value} />
+      </form>
+    </div>
+    ${notice ? html`<div class="status inbox-notice" role="status">${notice}</div>` : nothing}
+    <div class="inbox-workbench">
+      <aside class="inbox-list" aria-label="Conversations">${conversationList()}</aside>
+      ${threadView()}
+    </div>
+    ${sendDialog()}
+  `, host);
+  replacePanePreservingFocus(host);
+}
+
+async function loadInbox(): Promise<void> {
+  if (loading) return;
+  loading = true;
+  notice = "";
+  draw();
+  try {
+    const result = await api<{ connected?: Source[]; conversations?: Conversation[]; warnings?: Source[] }>("/api/aitlas/inbox", {
+      method: "POST",
+      body: JSON.stringify({ sources: [...enabled], query: query.trim() }),
+    });
+    connected = result.connected ?? [];
+    conversations = result.conversations ?? [];
+    if (!connected.includes(composeSource)) composeSource = connected[0] ?? "gmail";
+    const warnings = result.warnings ?? [];
+    if (warnings.length) notice = `${warnings.map((source) => LABEL[source]).join(", ")} could not refresh. Other conversations are current.`;
+    if (selected) selected = conversations.find((row) => row.id === selected?.id) ?? selected;
+  } catch (error) {
+    notice = errMessage(error, "Could not load your inbox.");
+  } finally {
+    loading = false;
+    draw();
+  }
+}
+
+async function openConversation(row: Conversation): Promise<void> {
+  selected = row;
+  composing = false;
+  messages = [];
+  beginReply(row);
+  threadLoading = true;
+  notice = "";
+  draw();
+  try {
+    const result = await api<{ messages?: Message[] }>("/api/aitlas/inbox/thread", {
+      method: "POST",
+      body: JSON.stringify({ source: row.source, threadId: row.threadId, channelId: row.channelId }),
+    });
+    if (selected?.id === row.id) messages = result.messages ?? [];
+  } catch (error) {
+    notice = errMessage(error, "Could not open that conversation.");
+  } finally {
+    threadLoading = false;
+    draw();
+  }
+}
+
+async function sendMessage(): Promise<void> {
+  if (sending || !confirmSend) return;
+  sending = true;
+  draw();
+  const row = selected;
+  const source = row?.source ?? composeSource;
+  try {
+    await api("/api/aitlas/inbox/send", {
+      method: "POST",
+      body: JSON.stringify({
+        requestId: crypto.randomUUID(),
+        source,
+        confirmed: true,
+        text: draft.trim(),
+        recipient: recipient.trim(),
+        subject: (subject || row?.title || "").trim(),
+        ...(row ? { threadId: row.threadId, messageId: row.messageId, channelId: row.channelId } : {}),
+      }),
+    });
+    draft = "";
+    confirmSend = false;
+    notice = "Message sent.";
+    if (row) await openConversation(row);
+    else {
+      composing = false;
+      await loadInbox();
+    }
+  } catch (error) {
+    notice = errMessage(error, "Could not send that message.");
+    confirmSend = false;
+  } finally {
+    sending = false;
+    draw();
+  }
+}
+
+export async function renderUnifiedInbox(): Promise<void> {
+  if (appState.currentView !== "inbox") return;
+  draw();
+  await loadInbox();
+}
diff --git a/plugins/web-ui/test/aitlas-routes.test.ts b/plugins/web-ui/test/aitlas-routes.test.ts
new file mode 100644
index 00000000..d7a044e2
--- /dev/null
+++ b/plugins/web-ui/test/aitlas-routes.test.ts
@@ -0,0 +1,163 @@
+import assert from "node:assert/strict";
+import type { IncomingMessage, ServerResponse } from "node:http";
+import { Readable } from "node:stream";
+import { after, test } from "node:test";
+import { handleAitlasRoute } from "../server/aitlas.ts";
+
+const calls: Array<{ path: string; body: string; capability: string }> = [];
+const originalFetch = globalThis.fetch;
+
+process.env.AITLAS_COMPOSIO_GATEWAY_URL = "http://localhost/api/qm/composio";
+process.env.AITLAS_BRAIN_GATEWAY_URL = "http://localhost/api/qm/brain";
+process.env.QM_MEMORY_REVIEWER = "reviewer@company.com";
+process.env.NODE_ENV = "test";
+
+globalThis.fetch = async (input, init) => {
+  const headers = new Headers(init?.headers);
+  calls.push({
+    path: String(input),
+    body: String(init?.body ?? ""),
+    capability: headers.get("x-agent-capability") ?? "",
+  });
+  const path = String(input);
+  const payload = path.endsWith("/catalog")
+    ? { toolkits: [] }
+    : path.endsWith("/graph")
+      ? { nodes: [], edges: [], links: [], records: [], sourceCount: 2 }
+    : path.endsWith("/inbox")
+      ? { connected: ["gmail"], conversations: [] }
+      : path.endsWith("/thread")
+        ? { messages: [] }
+        : path.endsWith("/send")
+          ? { status: "sent" }
+          : { connections: [] };
+  return new Response(JSON.stringify(payload), { status: 200, headers: { "content-type": "application/json" } });
+};
+
+after(() => {
+  globalThis.fetch = originalFetch;
+});
+
+const ctx = {
+  user: "alice",
+  displayName: "Alice",
+  coreFetch: async (_method: "GET" | "POST" | "PUT" | "PATCH" | "DELETE", path: string, body = "") => {
+    if (path === "/v1/session-cap") return { status: 200, text: JSON.stringify({ token: "scope-capability" }) };
+    calls.push({ path, body, capability: "" });
+    return { status: 202, text: JSON.stringify({ runId: "run-sync" }) };
+  },
+  coreFetchCap: async (_method: "GET" | "POST" | "PUT" | "PATCH" | "DELETE", path: string, body = "") => {
+    if (path === "/v1/admin/whoami") return { status: 200, text: JSON.stringify({ permissions: ["admin"] }) };
+    calls.push({ path, body, capability: "scope-capability" });
+    const recipient = JSON.parse(body || "{}") as { recipient?: string };
+    return { status: 200, text: JSON.stringify({ ok: true, deliveryId: "delivery-1", recipient: { displayName: recipient.recipient ?? "Reviewer" } }) };
+  },
+};
+
+async function request(path: string, method = "GET", body = "", requestContext = ctx): Promise<{ status: number; body: string }> {
+  const req = Readable.from(body ? [Buffer.from(body)] : []) as IncomingMessage;
+  let status = 0;
+  let responseBody = "";
+  const res = {
+    writeHead(nextStatus: number) {
+      status = nextStatus;
+      return this;
+    },
+    end(value?: string) {
+      responseBody = value ?? "";
+      return this;
+    },
+  } as unknown as ServerResponse;
+  await handleAitlasRoute(req, res, path, method, requestContext);
+  return { status, body: responseBody };
+}
+
+test("keeps the scope capability server-side for the personal catalog", async () => {
+  const response = await request("/api/aitlas/connections/catalog");
+  assert.equal(response.status, 200);
+  assert.equal(calls.find((call) => call.path.endsWith("/catalog"))?.capability, "scope-capability");
+  assert.ok(!response.body.includes("scope-capability"));
+});
+
+test("sends memory as an explicit review suggestion without writing company memory", async () => {
+  const response = await request(
+    "/api/aitlas/memory/suggest",
+    "POST",
+    JSON.stringify({ fact: "Client asked to move the meeting." }),
+  );
+  assert.equal(response.status, 200);
+  const reach = calls.find((call) => call.path === "/v1/reach");
+  assert.equal(reach?.capability, "scope-capability");
+  assert.match(reach?.body ?? "", /reviewer@company\.com/);
+  assert.match(reach?.body ?? "", /approve MEM-[A-F0-9]{8}/);
+  assert.match(reach?.body ?? "", /delivery alone changes nothing/);
+  assert.ok(!calls.some((call) => call.path.startsWith("/v1/memory/facts")));
+  const body = JSON.parse(response.body) as { reference?: string; recipient?: string };
+  assert.match(body.reference ?? "", /^MEM-[A-F0-9]{8}$/);
+  assert.equal(body.recipient, "reviewer@company.com");
+});
+
+test("keeps inbox reads and confirmed sends behind the server-side scope capability", async () => {
+  const inbox = await request("/api/aitlas/inbox", "POST", JSON.stringify({ sources: ["gmail"], query: "client" }));
+  assert.equal(inbox.status, 200);
+  const read = calls.find((call) => call.path.endsWith("/inbox"));
+  assert.equal(read?.capability, "scope-capability");
+  assert.deepEqual(JSON.parse(read?.body ?? "{}"), { sources: ["gmail"], query: "client" });
+
+  const sent = await request("/api/aitlas/inbox/send", "POST", JSON.stringify({ requestId: "request-123", source: "gmail", recipient: "client@example.test", confirmed: true, text: "Hello" }));
+  assert.equal(sent.status, 200);
+  const send = calls.find((call) => call.path.endsWith("/send"));
+  assert.equal(send?.capability, "scope-capability");
+  assert.ok(!sent.body.includes("scope-capability"));
+});
+
+test("shows an admin only the source-derived Brain Map and drops caller-selected scope fields", async () => {
+  const response = await request(
+    "/api/aitlas/brain/graph",
+    "POST",
+    JSON.stringify({ query: "Synthetic Clinic", connector: "ghl", entityType: "client", limit: 75, sourceId: "leadership-restricted", grants: ["all"] }),
+  );
+  assert.equal(response.status, 200);
+  const graph = calls.findLast((call) => call.path.endsWith("/graph"));
+  assert.equal(graph?.capability, "scope-capability");
+  assert.deepEqual(JSON.parse(graph?.body ?? "{}"), { query: "Synthetic Clinic", connector: "ghl", entityType: "client", limit: 75 });
+  assert.ok(!response.body.includes("scope-capability"));
+});
+
+test("does not expose the Brain Map route to a non-admin", async () => {
+  const nonAdminContext = {
+    ...ctx,
+    coreFetchCap: async () => ({ status: 200, text: JSON.stringify({ permissions: [] }) }),
+  };
+  const callCount = calls.length;
+  const response = await request("/api/aitlas/brain/graph", "POST", JSON.stringify({ query: "client" }), nonAdminContext);
+  assert.equal(response.status, 403);
+  assert.equal(calls.length, callCount);
+});
+
+test("returns the resolved handoff recipient and a traceable reference", async () => {
+  const response = await request(
+    "/api/aitlas/handoff",
+    "POST",
+    JSON.stringify({ recipient: "Avery", note: "Cover the client", neededBy: "2026-08-08" }),
+  );
+  assert.equal(response.status, 200);
+  const result = JSON.parse(response.body) as { recipient?: string; reference?: string };
+  assert.equal(result.recipient, "Avery");
+  assert.match(result.reference ?? "", /^HAND-[A-F0-9]{8}$/);
+  const reach = calls.findLast((call) => call.path === "/v1/reach");
+  assert.match(reach?.body ?? "", /accept HAND-[A-F0-9]{8}/);
+  assert.match(reach?.body ?? "", /complete HAND-[A-F0-9]{8}/);
+});
+
+test("queues sync in the signed-in person's own web conversation", async () => {
+  const response = await request(
+    "/api/aitlas/connections/sync",
+    "POST",
+    JSON.stringify({ toolkit: "gmail" }),
+  );
+  assert.equal(response.status, 202);
+  const turn = calls.find((call) => call.path.startsWith("/v1/turns"));
+  assert.match(turn?.body ?? "", /web:alice:connections/);
+  assert.match(turn?.body ?? "", /three-hour incremental sync/);
+});
