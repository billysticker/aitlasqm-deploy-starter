+async function load(): Promise<void> {
+  const version = ++requestVersion, tool = connector;
+  loading = true; notice = ""; draw();
+  try {
+    const request = (connector = "") => api<BrainGraph>("/api/aitlas/brain/graph", { method: "POST", body: JSON.stringify({ connector, limit: 100 }) });
+    const [base, evidence] = await Promise.all([request(), tool ? request(tool) : Promise.resolve(null)]);
+    if (version !== requestVersion || appState.currentView !== "brain") return;
+    availableTools = [...new Set([...base.nodes.map(node => node.connector), ...base.records.map(record => record.connector), tool].filter(Boolean))].sort() as string[];
+    const combined = evidence ? {
+      ...evidence, sourceCount: base.sourceCount, topologyStatus: base.topologyStatus,
+      nodes: [...[...base.nodes.filter(node => node.operational), ...evidence.nodes].reduce((nodes, node) => nodes.set(node.id, { ...nodes.get(node.id), ...node }), new Map<string, BrainNode>()).values()],
+      edges: [...base.edges.filter(edge => edge.operational), ...evidence.edges.filter(edge => !edge.operational)],
+    } : base;
+    graph = withEvidenceEdges(combined);
+    if (person && !graph.nodes.some(node => node.id === person)) person = "";
+    if (selectedId && !graph.nodes.some(node => node.id === selectedId)) {
+      selectedId = ""; profileOpen = false; notice = "That profile is no longer available in your authorized view.";
+    }
+    selectedEdge = null;
+  } catch (error) {
+    if (version !== requestVersion) return;
+    notice = errMessage(error, "The Brain Map could not be loaded.");
+    graph = emptyGraph(); selectedEdge = null;
+  } finally {
+    if (version === requestVersion) { loading = false; draw(); }
+  }
+}
+export async function renderBrainMap(): Promise<void> {
+  draw(); await load();
+}
