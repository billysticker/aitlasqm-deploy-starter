+        return svg`<g class="brain-edge" role="button" tabindex="0" aria-label=${label} @click=${() => inspectEdge(edge)} @keydown=${(event: KeyboardEvent) => { if (event.key === "Enter" || event.key === " ") { event.preventDefault(); inspectEdge(edge); } }}>
