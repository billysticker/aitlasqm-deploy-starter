+    >
+      <div class="own-connections-eyebrow">${suggestion ? "Company memory suggestion" : "Team handoff"}</div>
+      <h2 id="memory-share-title">${suggestion ? "Suggest this to the company" : "Hand this work to a teammate"}</h2>
+      <p>${suggestion ? "This sends a suggestion for review. It does not automatically copy your private memory." : "The teammate receives a private handoff with only the note below."}</p>
+      ${suggestion
+        ? html`<div class="memory-share-preview">${draft.fact}</div>`
+        : html`
+            <label>Teammate<input required maxlength="120" placeholder="Name or work email" .value=${draft.recipient} @input=${(event: Event) => {
+              draft.recipient = (event.target as HTMLInputElement).value;
+            }} /></label>
+            <label>Needed by<input type="date" .value=${draft.neededBy} @input=${(event: Event) => {
+              draft.neededBy = (event.target as HTMLInputElement).value;
+            }} /></label>
+            <label>Handoff note<textarea required maxlength="1000" .value=${draft.note} @input=${(event: Event) => {
+              draft.note = (event.target as HTMLTextAreaElement).value;
+            }}></textarea></label>
+          `}
+      <div class="actions">
+        <button class="btn" type="button" ?disabled=${draft.pending} @click=${closeMemoryShare}>Cancel</button>
+        <button class="btn primary" type="submit" ?disabled=${draft.pending}>
+          ${icon(Send, 14)} ${draft.pending ? "Sending…" : suggestion ? "Send suggestion" : "Send handoff"}
+        </button>
+      </div>
+    </form>
+  </div>`;
+}
+
+async function submitMemoryShare(): Promise<void> {
+  const draft = memoryShareDialog;
+  if (!draft || draft.pending) return;
+  draft.pending = true;
+  drawMemory();
+  try {
+    if (draft.kind === "suggest") {
+      const result = await api<{ recipient?: string; reference?: string }>("/api/aitlas/memory/suggest", { method: "POST", body: JSON.stringify({ fact: draft.fact }) });
+      memoryNotice = `${result.reference ? `${result.reference} · ` : ""}Sent to ${result.recipient || "the company reviewer"}. Your private memory is unchanged until approved.`;
