+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { fileURLToPath } from "node:url";
+import { JSDOM } from "jsdom";
+import { createServer } from "vite";
+
+test("Brain Map renders SVG relationships and supports node selection", async () => {
+  const dom = new JSDOM('<!doctype html><div id="app"></div><main id="main"></main>', { url: "http://localhost/brain" });
+  Object.defineProperty(dom.window, "matchMedia", { value: () => ({ matches: false, addEventListener() {}, removeEventListener() {} }) });
+  const globals = {
+    window: dom.window, document: dom.window.document, location: dom.window.location,
+    history: dom.window.history, localStorage: dom.window.localStorage, navigator: dom.window.navigator,
+    HTMLElement: dom.window.HTMLElement, HTMLDialogElement: dom.window.HTMLDialogElement,
+    customElements: dom.window.customElements, Node: dom.window.Node, Event: dom.window.Event,
+    MouseEvent: dom.window.MouseEvent, SubmitEvent: dom.window.SubmitEvent, InputEvent: dom.window.InputEvent,
+    requestAnimationFrame: (callback: FrameRequestCallback) => setTimeout(() => callback(Date.now()), 0),
+    cancelAnimationFrame: clearTimeout, getComputedStyle: dom.window.getComputedStyle.bind(dom.window),
+  };
+  const previous = new Map(Object.keys(globals).map((key) => [key, Object.getOwnPropertyDescriptor(globalThis, key)]));
+  const originalFetch = globalThis.fetch;
+  for (const [key, value] of Object.entries(globals)) Object.defineProperty(globalThis, key, { configurable: true, writable: true, value });
+  globalThis.fetch = async (input) => {
+    assert.equal(String(input), "/api/aitlas/brain/graph");
+    return Response.json({
+      nodes: [
+        { id: "person-1", type: "person", authority: "operational", label: "Example teammate" },
+        { id: "client-1", type: "client", authority: "operational", label: "Example client" },
+      ],
+      edges: [{ id: "edge-1", from: "person-1", to: "client-1", type: "assigned-to", confidence: 1, provenance: "fixture", operational: true }],
+      links: [], records: [], sourceCount: 1, topologyStatus: "current",
+    });
+  };
+  const vite = await createServer({ root: fileURLToPath(new URL("../", import.meta.url)), server: { middlewareMode: true, hmr: false }, appType: "custom" });
+  try {
+    const { appState } = await vite.ssrLoadModule("/src/shell-state.ts");
+    const { renderBrainMap } = await vite.ssrLoadModule("/src/brain-map.ts");
+    appState.me = { user: "owner", org: "example" };
+    appState.currentView = "brain";
+    appState.mainEl = document.querySelector("#main");
+    await renderBrainMap();
+    const model = await vite.ssrLoadModule("/src/brain-map-model.ts");
+    const canvas = document.querySelector("svg.brain-canvas")!;
+    assert.ok(canvas);
+    assert.equal(canvas.querySelectorAll(".brain-node").length, 2);
+    assert.equal(canvas.querySelectorAll(".brain-edge").length, 1);
+    for (const element of canvas.querySelectorAll("*")) {
+      assert.equal(element.namespaceURI, "http://www.w3.org/2000/svg", `${element.tagName} must be SVG to paint`);
+    }
+    canvas.querySelector(".brain-node-person")!.dispatchEvent(new dom.window.MouseEvent("click", { bubbles: true }));
+    assert.match(document.querySelector(".brain-detail-panel")!.textContent!, /Example teammate/);
+    assert.match(document.querySelector(".brain-neighbor-list")!.textContent!, /Example client/);
+    document.querySelector(".brain-node-client")!.dispatchEvent(new dom.window.KeyboardEvent("keydown", { key: "Enter", bubbles: true }));
+    assert.match(document.querySelector(".brain-detail-head h2")!.textContent!, /Example client/);
+    const button = (text: string) => [...document.querySelectorAll<HTMLButtonElement>("button")].find(el => el.textContent?.includes(text))!;
+    button("Expand profile").click();
+    assert.ok(document.querySelector(".brain-profile-expanded"));
+    button("Previous profile").click();
+    assert.match(document.querySelector(".brain-detail-head h2")!.textContent!, /Example teammate/);
+    button("Back to map").click();
+    document.querySelector(".brain-edge")!.dispatchEvent(new dom.window.KeyboardEvent("keydown", { key: "Enter", bubbles: true }));
+    assert.match(document.querySelector(".brain-detail-head h2")!.textContent!, /Assigned To/);
+    button("Open Example client profile").click();
+    assert.match(document.querySelector(".brain-detail-head h2")!.textContent!, /Example client/);
+
+    const node = (id: string, type: string, connector?: string) => ({ id, type, label: id, authority: "aios", operational: true, connector });
+    const edge = (from: string, to: string) => ({ id: from + to, from, to, type: "managed-by", confidence: 1, provenance: "aios", operational: true });
+    const fixture = model.withEvidenceEdges({
+      nodes: [node("Alex","person"),node("Blair","person"),node("A","client"),node("B","client"),node("C","client"),node("Operations","department"),node("Fathom","tool-account"),node("Google","tool-account","google-ads")],
+      edges: [edge("Alex","A"),edge("Alex","B"),edge("Blair","C"),edge("Alex","Operations"),edge("Blair","Operations"),edge("B","Google")],
+      links: [
+        { recordId:"r1",entityId:"A",type:"for-client",confidence:1,provenance:"aios-mapped" },
+        { recordId:"r1",entityId:"Fathom",type:"uses-tool",confidence:1,provenance:"connector-profile" },
+        { recordId:"r2",entityId:"Operations",type:"in-department",confidence:.8,provenance:"connector-profile" },
+        { recordId:"r2",entityId:"Fathom",type:"uses-tool",confidence:1,provenance:"connector-profile" },
+      ],
+      records: [
+        {id:"r1",connector:"fathom",title:"Verified client meeting",sourceId:"owner"},
+        {id:"r2",connector:"fathom",title:"B C mentioned but unmapped",sourceId:"owner"},
+      ], sourceCount:1
+    });
+    const filters = {person:"Alex",selectedId:"Alex",connector:"fathom",query:"",entityType:"client"};
+    let view = model.visibleGraph(fixture, filters);
+    assert.deepEqual(view.nodes.map((n: any) => n.id).sort(), ["A","Alex","Fathom"]);
+    assert.equal(view.edges.length, 2, "person-client-tool path is preserved");
+    assert.ok(!view.nodes.some((n: any) => ["B","C","Blair","Operations"].includes(n.id)), "shared department is not tool evidence");
+    view = model.visibleGraph(fixture, {...filters,connector:"",entityType:""});
+    assert.ok(view.nodes.some((n: any) => n.id === "B"));
+    assert.ok(!view.nodes.some((n: any) => n.id === "Blair" || n.id === "C"));
+    view = model.visibleGraph(fixture, {...filters,person:"Blair",selectedId:"Blair"});
+    assert.equal(view.nodes.length, 0, "no fabricated Fathom match from title or department");
+    assert.equal(model.safeSourceUrl("javascript:alert(1)"), null);
+    assert.equal(model.safeSourceUrl("https://user:pass@example.com"), null);
+    assert.equal(model.safeSourceUrl("https://example.com/meeting"), "https://example.com/meeting");
+    globalThis.fetch = async () => Response.json(fixture);
+    const { resetBrainMapState } = await vite.ssrLoadModule("/src/brain-map.ts");
+    resetBrainMapState();
