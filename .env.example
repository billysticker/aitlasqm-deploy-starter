# Copy this file to .env and fill values only in that ignored file. Never commit
# or paste secret values into chat, issues, documentation, or shell output.

# First verified administrator, for example admin@customer.example:org_admin.
ADMIN_GRANTS=

# OpenRouter bills model usage because qm.config.jsonc selects openrouter.
OPENROUTER_API_KEY=

# Generate each value independently; never reuse one key for another purpose.
# Example generator: openssl rand -hex 32
CAPABILITY_SECRET=
CONNECTOR_SECRET_KEY=
CORE_SIGNING_SECRET=
PORTAL_IDENTITY_SECRET=
PORTAL_SESSION_SECRET=
SKILL_SIGNING_SECRET=

# Fly deploy token scoped to the customer's sandbox app.
FLY_SANDBOX_API_TOKEN=

# Public core self-API URL reachable from agent sandboxes.
PUBLIC_API_URL=

# Slack OIDC credentials for portal sign-in.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional until the Slack bot is enabled.
# SLACK_APP_TOKEN=
# SLACK_BOT_TOKEN=

# Optional provider fallbacks. Uncomment only when configured and customer-owned.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
