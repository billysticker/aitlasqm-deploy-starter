# Public HTTPS origin of this gateway. Do not include /api/qm/composio.
GATEWAY_PUBLIC_URL=https://replace-me-gateway.fly.dev

# Public HTTPS URL of the customer-owned QM core service.
QM_CORE_API_URL=https://replace-me-core.fly.dev

# Server-only key for the customer's dedicated Composio project.
QM_COMPOSIO_API_KEY=

# Generate independently with: openssl rand -hex 32
QM_COMPOSIO_IDENTITY_SECRET=

# Optional toolkit slug -> enabled Composio auth configuration ID.
# Example: {"fathom":"ac_customer_owned_id"}
QM_COMPOSIO_AUTH_CONFIGS_JSON={}
